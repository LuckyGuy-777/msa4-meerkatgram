<?xml version="1.0" encoding="utf-8" ?>
<!DOCTYPE mapper
        PUBLIC "-//mybatis.org//DTD Mapper 3.0//EN"
        "http://mybatis.org/dtd/mybatis-3-mapper.dtd">

<mapper namespace="com.msa4meerkatgram.domain.user.mapper.UserMapper">
    <resultMap id="UserResultMap" type="com.msa4meerkatgram.domain.user.entities.User">
        <result column="id" property="id" />
        <result column="email" property="email" />
        <result column="password" property="password" />
        <result column="nick" property="nick" />
        <result column="provider" property="provider" />
        <result column="role" property="role" />
        <result column="profile" property="profile" />
        <result column="refresh_token" property="refreshToken" />
        <result column="created_at" property="createdAt" />
        <result column="updated_at" property="updatedAt" />
        <result column="deleted_at" property="deletedAt" />
    </resultMap>

    <select id="findByPk" resultMap="UserResultMap">
        SELECT
            *
        FROM
            users
        WHERE
            deleted_at IS NULL

          AND id = #{id}
    </select>


    <select id="findByEmail" resultMap="UserResultMap">
        SELECT
            *
        FROM
            users
        WHERE
            deleted_at IS NULL
          AND email = #{email}
    </select>
</mapper>

<!--


LIMIT #{offset}, #{limit} 는,
List<Post> getPagination(int limit, int offset);
이 설정되어 있어서,
LIMIT #{offset}, #{limit} 이렇게 줄 수 있음
-->



<!--
<select id="getTotal"> 의 id 부분에, PostMapper에
getTotal 이라는 추상메서드가 있어야, id="getTotal" 으로
세팅할 수 있다.


-->