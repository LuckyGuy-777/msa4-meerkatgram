<?xml version="1.0" encoding="utf-8" ?>
<!DOCTYPE mapper
        PUBLIC "-//mybatis.org//DTD Mapper 3.0//EN"
        "http://mybatis.org/dtd/mybatis-3-mapper.dtd">

<mapper namespace="com.msa4meerkatgram.domain.auth.mapper.AuthMapper">
    <resultMap id="UserResultMap" type="com.msa4meerkatgram.domain.user.entities.UserMybatis">
        <id column="id" property="id" />
        <result column="email" property="email" />
        <result column="password" property="password" />
        <result column="nick" property="nick" />
        <result column="provider" property="provider" />
        <result column="role" property="role" />
        <result column="profile" property="profile" />
        <result column="refresh_token" property="refreshToken" />
        <result column="created_at" property="createdAt" />
        <result column="updated_at" property="updatedAt" />
        <result column="deleted_at" property="deletedAt" />
    </resultMap>





    <update
            id="updateRefreshToken"
            parameterType="com.msa4meerkatgram.domain.user.entities.UserMybatis"
    >
        UPDATE
           users
        SET
            refresh_token = #{refreshToken}
            ,updated_at = NOW()
        WHERE
            id = #{id}
    </update>


    <insert
        id="create"
        parameterType="com.msa4meerkatgram.domain.user.entities.UserMybatis"
        useGeneratedKeys="true"
        keyProperty="id"
    >
        INSERT INTO users(
            email
            ,password
            ,nick
            ,role
            ,provider
            ,profile
        ) VALUES (
             #{email}
             ,#{password}
             ,#{nick}
             ,#{role}
             ,#{provider}
             ,#{profile}
        )
    </insert>
</mapper>

<!--
<update id="updateRefreshToken">
에서, id는, 메퍼의 추상메소드 이름을 쓰면됨.

refresh_token = #{refreshToken}
받은 리프레시 토큰을 세팅해주는것
추상메소드의 인수에 있는걸 가져옴

updated_at = NOW()
updated_at 레코드에, 지금 일시를 세팅

id = #{id}
추상메소드의 인수에 있는걸 가져옴

추상메소드에서 매개변수로 주어줘야
#{id}, #{refreshToken} 을 쓸수 있음
AuthMapper에, id와 refreshToken을 인수로 받아주고 있기에 사용가능

-->